# Official API keys. Subscriptions (grok login, agy, cursor-agent, codex auth login)
# are preferred when present and do not need these.

# XAI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional custom API bases for the API-key path only.
# Defaults are the official hosts. Unofficial routers are never implied.

# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional prompt-compiler models for --optimize
# LOCAL_IMAGE_GEN_OPTIMIZE_MODEL_GROK=grok-4.6
# LOCAL_IMAGE_GEN_OPTIMIZE_MODEL_OPENAI=gpt-5.6-terra
# CODEX_RESPONSE_MODEL=gpt-5.6-terra
# LOCAL_IMAGE_GEN_OPTIMIZE_MODEL_GEMINI=gemini-2.5-flash

# Skip the doctor freshness GET (set this on Dyro's 5s sidecar spawn)
# LOCAL_IMAGE_GEN_SKIP_UPDATE_CHECK=1
