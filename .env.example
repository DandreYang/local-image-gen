# Official API keys. Subscriptions (grok login, agy, cursor-agent, codex auth login)
# are preferred when present and do not need these.

# XAI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional custom API bases for the API-key path only.
# Defaults are the official hosts. Unofficial routers are never implied.

# XAI_BASE_URL=https://api.x.ai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
